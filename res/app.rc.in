#pragma code_page(65001)

// This is a template: CMake and build.cmd fill the @CLICKSHOW_*@ placeholders
// from src/version.h before invoking rc.exe. Do not embed it directly.
#include <windows.h>
#include <commctrl.h>
#include "resource.h"

IDI_CLICKSHOW ICON "@CLICKSHOW_ICON@"
1 RT_MANIFEST "@CLICKSHOW_MANIFEST@"

IDD_MAIN DIALOGEX 0, 0, 280, 328
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "ClickShow"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x86
BEGIN
    CONTROL "显示点击特效(_C)", IDC_CHK_CIRCLE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 8, 130, 12
    CONTROL "显示位置提示浮标(_F)", IDC_CHK_HOVER, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 26, 150, 12
    CONTROL "启用鼠标点击计数(_N)", IDC_CHK_COUNT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 44, 150, 12
    CONTROL "启用键盘计数(_K)", IDC_CHK_KEYCOUNT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 62, 130, 12
    CONTROL "开机自动启动(_S)", IDC_CHK_AUTOSTART, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 80, 130, 12

    CONTROL "点击波纹", -1, "Button", BS_GROUPBOX, 8, 100, 264, 116
    LTEXT "大小:", -1, 18, 114, 30, 10
    LTEXT "150", IDC_TXT_SIZE, 50, 114, 30, 10
    CONTROL "", IDC_SLIDER_SIZE, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 84, 110, 180, 18

    CONTROL "左键", IDC_CHK_BTN_LEFT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 18, 132, 70, 12
    CONTROL "颜色", IDC_BTN_COLOR_LEFT, "Button", BS_OWNERDRAW | WS_TABSTOP, 100, 130, 52, 15
    CONTROL "中键", IDC_CHK_BTN_MIDDLE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 18, 149, 70, 12
    CONTROL "颜色", IDC_BTN_COLOR_MIDDLE, "Button", BS_OWNERDRAW | WS_TABSTOP, 100, 147, 52, 15
    CONTROL "右键", IDC_CHK_BTN_RIGHT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 18, 166, 70, 12
    CONTROL "颜色", IDC_BTN_COLOR_RIGHT, "Button", BS_OWNERDRAW | WS_TABSTOP, 100, 164, 52, 15
    CONTROL "侧键(后退)", IDC_CHK_BTN_X1, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 18, 183, 78, 12
    CONTROL "颜色", IDC_BTN_COLOR_X1, "Button", BS_OWNERDRAW | WS_TABSTOP, 100, 181, 52, 15
    CONTROL "侧键(前进)", IDC_CHK_BTN_X2, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 18, 200, 78, 12
    CONTROL "颜色", IDC_BTN_COLOR_X2, "Button", BS_OWNERDRAW | WS_TABSTOP, 100, 198, 52, 15

    CONTROL "位置浮标", -1, "Button", BS_GROUPBOX, 8, 222, 264, 56
    LTEXT "大小:", -1, 18, 236, 30, 10
    LTEXT "60", IDC_TXT_HOVER, 50, 236, 30, 10
    CONTROL "", IDC_SLIDER_HOVER, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 84, 232, 180, 18
    LTEXT "颜色:", -1, 18, 254, 30, 10
    CONTROL "颜色", IDC_BTN_COLOR_HOVER, "Button", BS_OWNERDRAW | WS_TABSTOP, 50, 252, 52, 15

    LTEXT "已有新版本!", IDC_LBL_NEWVERSION, 8, 288, 90, 10
    PUSHBUTTON "默认值", IDC_BTN_DEFAULT, 8, 302, 56, 15
    PUSHBUTTON "计数信息查看", IDC_BTN_COUNT_INFO, 68, 302, 76, 15
    PUSHBUTTON "反馈与更新", IDC_BTN_HOME, 148, 302, 64, 15
    PUSHBUTTON "退出", IDC_BTN_EXIT, 216, 302, 56, 15
END

IDD_COUNT_INFO DIALOGEX 0, 0, 1040, 212
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "计数信息"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x86
BEGIN
    LTEXT "累计点击:", -1, 12, 10, 48, 12
    LTEXT "0", IDC_TXT_MOUSETOTAL, 60, 10, 60, 12
    LTEXT "累计按键:", -1, 192, 10, 48, 12
    LTEXT "0", IDC_TXT_KEYTOTAL, 240, 10, 80, 12
    PUSHBUTTON "关闭", IDCLOSE, 962, 6, 60, 18
    PUSHBUTTON "重置鼠标计数", IDC_BTN_RESET_MOUSECOUNT, 770, 6, 90, 18
    PUSHBUTTON "重置键盘计数", IDC_BTN_RESET_KEYCOUNT, 866, 6, 90, 18
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @CLICKSHOW_VERSION_COMMA@
 PRODUCTVERSION @CLICKSHOW_VERSION_COMMA@
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "ClickShow"
            VALUE "FileDescription", "ClickShow C++"
            VALUE "FileVersion", "@CLICKSHOW_VERSION_FULL@"
            VALUE "InternalName", "ClickShow"
            VALUE "OriginalFilename", "ClickShow.exe"
            VALUE "ProductName", "ClickShow"
            VALUE "ProductVersion", "@CLICKSHOW_VERSION_FULL@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
