#pragma code_page(65001)

// This is a template: CMake and build.cmd fill the @CLICKSHOW_*@ placeholders
// from src/version.h before invoking rc.exe. Do not embed it directly.
#include <windows.h>
#include <commctrl.h>
#include "resource.h"

IDI_CLICKSHOW ICON "@CLICKSHOW_ICON@"
1 RT_MANIFEST "@CLICKSHOW_MANIFEST@"

IDD_MAIN DIALOGEX 0, 0, 280, 368
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "ClickShow"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x86
BEGIN
    CONTROL "软件设置", -1, "Button", BS_GROUPBOX, 8, 8, 264, 32
    CONTROL "开机自动启动(_S)", IDC_CHK_AUTOSTART, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 18, 22, 200, 12

    CONTROL "鼠标监控", -1, "Button", BS_GROUPBOX, 8, 46, 264, 216
    CONTROL "显示点击特效(_C)", IDC_CHK_CIRCLE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 18, 60, 200, 12
    CONTROL "显示位置提示浮标(_F)", IDC_CHK_HOVER, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 18, 76, 200, 12
    CONTROL "启用鼠标点击计数(_N)", IDC_CHK_COUNT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 18, 92, 200, 12

    LTEXT "波纹大小:", -1, 18, 110, 44, 10
    LTEXT "150", IDC_TXT_SIZE, 64, 110, 26, 10
    CONTROL "", IDC_SLIDER_SIZE, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 94, 106, 166, 16

    CONTROL "左键", IDC_CHK_BTN_LEFT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 18, 128, 36, 12
    CONTROL "颜色", IDC_BTN_COLOR_LEFT, "Button", BS_OWNERDRAW | WS_TABSTOP, 58, 127, 40, 13
    LTEXT "0", IDC_TXT_BTN_LEFT, 110, 128, 64, 12
    CONTROL "中键", IDC_CHK_BTN_MIDDLE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 18, 144, 36, 12
    CONTROL "颜色", IDC_BTN_COLOR_MIDDLE, "Button", BS_OWNERDRAW | WS_TABSTOP, 58, 143, 40, 13
    LTEXT "0", IDC_TXT_BTN_MIDDLE, 110, 144, 64, 12
    CONTROL "右键", IDC_CHK_BTN_RIGHT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 18, 160, 36, 12
    CONTROL "颜色", IDC_BTN_COLOR_RIGHT, "Button", BS_OWNERDRAW | WS_TABSTOP, 58, 159, 40, 13
    LTEXT "0", IDC_TXT_BTN_RIGHT, 110, 160, 64, 12
    CONTROL "侧键1", IDC_CHK_BTN_X1, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 18, 176, 36, 12
    CONTROL "颜色", IDC_BTN_COLOR_X1, "Button", BS_OWNERDRAW | WS_TABSTOP, 58, 175, 40, 13
    LTEXT "0", IDC_TXT_BTN_X1, 110, 176, 64, 12
    CONTROL "侧键2", IDC_CHK_BTN_X2, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 18, 192, 36, 12
    CONTROL "颜色", IDC_BTN_COLOR_X2, "Button", BS_OWNERDRAW | WS_TABSTOP, 58, 191, 40, 13
    LTEXT "0", IDC_TXT_BTN_X2, 110, 192, 64, 12

    LTEXT "鼠标计数：0", IDC_TXT_MOUSETOTAL, 18, 210, 200, 12

    LTEXT "位置浮标:", -1, 18, 228, 44, 10
    LTEXT "60", IDC_TXT_HOVER, 64, 228, 26, 10
    CONTROL "", IDC_SLIDER_HOVER, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 94, 224, 166, 16
    LTEXT "浮标颜色:", -1, 18, 248, 44, 10
    CONTROL "颜色", IDC_BTN_COLOR_HOVER, "Button", BS_OWNERDRAW | WS_TABSTOP, 58, 247, 40, 13

    CONTROL "键盘监控", -1, "Button", BS_GROUPBOX, 8, 270, 264, 52
    CONTROL "启用键盘计数(_K)", IDC_CHK_KEYCOUNT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 18, 284, 200, 12
    LTEXT "键盘计数：0", IDC_TXT_KEYTOTAL, 18, 302, 200, 12

    LTEXT "已有新版本!", IDC_LBL_NEWVERSION, 8, 330, 90, 10
    PUSHBUTTON "默认值", IDC_BTN_DEFAULT, 8, 344, 56, 15
    PUSHBUTTON "键盘计数", IDC_BTN_COUNT_INFO, 68, 344, 76, 15
    PUSHBUTTON "反馈更新", IDC_BTN_HOME, 148, 344, 64, 15
    PUSHBUTTON "退出", IDC_BTN_EXIT, 216, 344, 56, 15
END

IDD_COUNT_INFO DIALOGEX 0, 0, 800, 200
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "计数信息"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x86
BEGIN
    PUSHBUTTON "关闭", IDCLOSE, 714, 6, 60, 17
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @CLICKSHOW_VERSION_COMMA@
 PRODUCTVERSION @CLICKSHOW_VERSION_COMMA@
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "ClickShow"
            VALUE "FileDescription", "ClickShow C++"
            VALUE "FileVersion", "@CLICKSHOW_VERSION_FULL@"
            VALUE "InternalName", "ClickShow"
            VALUE "OriginalFilename", "ClickShow.exe"
            VALUE "ProductName", "ClickShow"
            VALUE "ProductVersion", "@CLICKSHOW_VERSION_FULL@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
