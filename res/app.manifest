<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <!-- Template: @CLICKSHOW_VERSION_FULL@ is substituted from src/version.h -->
